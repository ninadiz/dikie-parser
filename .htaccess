RewriteEngine On
RewriteBase /

# Never serve internals directly over HTTP — they're only meant to be
# required by other PHP scripts or run via CLI/git, not requested by a browser.
# config.php is already safe-by-construction (a bare `return [...]` outputs nothing
# when hit directly), but it's blocked too for defense in depth since it holds secrets.
RewriteRule ^(run_migrations\.php|db\.php|vk_api\.php|config\.php|config\.example\.php)$ - [F,L]
RewriteRule ^migrations/ - [F,L]
RewriteRule ^\.git/ - [F,L]
RewriteRule ^\.gitignore$ - [F,L]
RewriteRule ^\.htaccess$ - [F,L]

# `git clone . <DocumentRoot>` (see DEPLOY.md) puts the whole repo in the docroot, not
# just the runtime files — block the dev-only directories and repo/doc files that come
# along with it but were never meant to be public.
RewriteRule ^(frontend|tests|\.github)/ - [F,L]
RewriteRule ^(README|DEPLOY|TZ_vk_wall_parser)\.md$ - [F,L]
RewriteRule ^(package(-lock)?\.json|playwright\.config\.ts)$ - [F,L]

# Real files (fetch.php, api/*.php, index.html, assets/*, favicon.svg) are served
# as-is. The built frontend bundle (frontend/vite.config.js
# builds it into dist/) must be deployed FLAT at the docroot root — copy dist/'s
# *contents*, not the dist/ folder itself. Many hosts (confirmed on HostiMan) put a
# static-file proxy in front of Apache that serves .js/.css straight from disk by
# literal path and 404s if it's not there, without ever consulting mod_rewrite — so
# a dist/ -> root rewrite alias silently never runs for those requests.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Everything else is an SPA route — fall back to the built entry point.
RewriteRule ^ index.html [L]
